# Copia este archivo como .env y completa solo lo que necesites. Nunca subas .env al repositorio.
# Sin GEMINI_API_KEY el agente arranca igual, en modo simulado (reglas fijas, sin modelo de lenguaje).

# --- Modelo de lenguaje ---------------------------------------------------------------------
# auto = Gemini si hay clave; si no, modo simulado. Valores: auto | gemini | simulado
LLM_PROVIDER=auto
# Clave de Google AI Studio (idealmente de un proyecto exclusivo para este agente)
GEMINI_API_KEY=
# Modelo de Gemini (por defecto gemini-3.5-flash-lite)
GEMINI_MODEL=
# Nivel de razonamiento: low | medium | high (por defecto low)
GEMINI_THINKING=
# Plazo por intento de llamada al modelo, en milisegundos; si vence se reintenta una vez (por defecto 30000)
LLM_TIMEOUT_MS=

# --- Límites de costo y abuso ---------------------------------------------------------------
# CA1: tope de iteraciones modelo → herramientas por turno (por defecto 25)
MAX_ITERACIONES=
# Tope de tokens por sesión (por defecto 400000) y global por día (por defecto 3000000)
MAX_TOKENS_SESION=
MAX_TOKENS_DIA=
# Mensajes por minuto por IP en el chat (por defecto 12)
MAX_MENSAJES_POR_MINUTO=

# --- Servidor -------------------------------------------------------------------------------
# Puerto HTTP (por defecto 3000)
PORT=
# Si se define (mínimo 8 caracteres), la API y los archivos de out/ exigen esta clave; el front la pide
ACCESS_KEY=
# 1 en despliegues públicos: si falta ACCESS_KEY, la API queda bloqueada en vez de abierta (falla cerrado)
EXIGIR_ACCESS_KEY=
# 1 solo detrás de un proxy confiable (Render) para limitar por la IP real del cliente
TRUST_PROXY=
